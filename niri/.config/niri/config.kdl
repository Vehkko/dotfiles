// ==============================
// niri 配置（dms 默认配置在前）
// ==============================

// dms 配置
// include "./dms/binds.kdl"  // 不需要 dms 的按键设置
include "./dms/alttab.kdl"
include "./dms/colors.kdl"
include "./dms/cursor.kdl"
include "./dms/layout.kdl"
include "./dms/wpblur.kdl"
include "./dms/outputs.kdl"

// ---------- 输入设备 ----------
input {
    keyboard {
        xkb { }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        click-method "clickfinger"
        dwt // disable-while-typing
    }

    mouse { 
        accel-speed -0.9  // -0.8
        accel-profile "adaptive"
    }
    trackpoint { }

    // warp-mouse-to-focus
    // focus-follows-mouse max-scroll-amount="0%"
}

// ---------- 输出/显示器 ----------
// output "eDP-1" {
//     mode "1920x1080@60.001"
//     scale 1.25
//     transform "normal"
//     position x=1280 y=0
// }
//
// output "HDMI-A-1" {
//     mode "2560x1440@60.000"
//     scale 1.5
//     transform "normal"
//     position x=1536 y=0
// }

// ---------- 模糊层 ------------
// layer-rule {
//     match namespace="dms:blurwallpaper"
//     place-within-backdrop true
// }

// layer-rule {
//     match namespace="^quickshell$"
//     place-within-backdrop true
// }


// ---------- 布局/外观 ----------
layout {
    gaps 5
    background-color "transparent"
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts { }
}

// ---------- 启动项 ----------
spawn-at-startup "fcitx5"

// 剪贴板历史：把复制内容喂给 cliphist
spawn-at-startup "bash" "-c" "wl-paste --watch cliphist store &"

// DMS 本体由 systemd --user 自启动，所以这里不再 spawn
// spawn-at-startup "dms" "run"

// polkit 代理（DMS 文档占位符：请替换成实际 polkit agent 路径，否则会尝试执行字面字符串）
// spawn-at-startup "{{POLKIT_AGENT_PATH}}"
spawn-at-startup "/usr/lib/mate-polkit/polkit-mate-authentication-agent-1"

// ---------- 热键提示/截图/动画 ----------
hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/图片/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations { }

// ---------- 环境变量 ----------
environment {
    XDG_CURRENT_DESKTOP "niri"
    QT_QPA_PLATFORM "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_QPA_PLATFORMTHEME_QT6 "qt6ct"
}

// ==============================
// window rules（以 DMS 风格为主 + 你的特例保留）
// ==============================

// 全局: 禁用标题栏
prefer-no-csd true

// WezTerm 初始 configure workaround（保留）
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Firefox 画中画默认浮动（保留）
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// GNOME 应用：透明/半透明时边框不画背景矩形（DMS）
window-rule {
    match app-id=r#"^org\.gnome\."#
    draw-border-with-background false
}

// 终端/透明类应用：同样关闭背景边框（DMS）
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="firefox"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    // match app-id="code"
    match app-id="thunar"
    draw-border-with-background false
    opacity 0.95
}

// vscode 专门设置
window-rule {
    match app-id="code"
    draw-border-with-background false
    opacity 0.9
}


// 非活动窗口轻微透明（DMS）
window-rule {
    match is-active=false
    opacity 0.88
}

// 全局圆角 + 裁剪（你当前设为 0：等于不开圆角）
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

// （可选）密码管理器录屏遮挡
/- window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}


// ==============================
// keybinds（按功能分块；中文注释；顺序重排）
// ==============================
binds {
    // ---------- 帮助/提示 ----------
    // 显示“重要快捷键”浮层
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ---------- 常用应用 ----------
    // 终端
    Mod+T hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }

    // neovide
    Mod+G hotkey-overlay-title="Open a Code Editor: neovide" { spawn "neovide"; }

    // ---------- DMS：启动器/桌面功能 ----------
    // Spotlight 启动器（替代 fuzzel）
    Mod+Space hotkey-overlay-title="Application Launcher" {
        spawn "dms" "ipc" "call" "spotlight" "toggle";
    }
    // 保留你原来的习惯：Mod+D 也打开 Spotlight
    Mod+A hotkey-overlay-title="Application Launcher (legacy)" {
        spawn "dms" "ipc" "call" "spotlight" "toggle";
    }

    // 剪贴板历史（占用 Mod+V）
    Mod+V hotkey-overlay-title="Clipboard Manager" {
        spawn "dms" "ipc" "call" "clipboard" "toggle";
    }

    // 任务/进程列表
    Mod+M hotkey-overlay-title="Task Manager" {
        spawn "dms" "ipc" "call" "processlist" "toggle";
    }

    // DMS 设置面板（占用 Mod+Comma）
    Mod+Comma hotkey-overlay-title="DMS Settings" {
        spawn "dms" "ipc" "call" "settings" "toggle";
    }

    // 通知中心
    Mod+N hotkey-overlay-title="Notification Center" {
        spawn "dms" "ipc" "call" "notifications" "toggle";
    }

    // 便签
    Mod+Shift+N hotkey-overlay-title="Notepad" {
      spawn "dms" "ipc" "call" "notepad" "toggle";  
    }

    // 壁纸浏览/切换
    Mod+Y hotkey-overlay-title="Browse Wallpapers" {
        spawn "dms" "ipc" "call" "dankdash" "wallpaper";
    }

    // 锁屏（替代 swaylock/hyprlock）
    Mod+Alt+L allow-when-locked=true hotkey-overlay-title="Lock Screen" {
        spawn "dms" "ipc" "call" "lock" "lock";
    }


    // 电源菜单（关机/重启/睡眠/休眠/注销）
    Mod+Backspace hotkey-overlay-title="Power Menu" {
        spawn "dms" "ipc" "call" "powermenu" "toggle";
    }

    // ---------- 多媒体：音量/麦克风/亮度 ----------
    // 音量（由 DMS 接管）
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "increment" "3";
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn "dms" "ipc" "call" "audio" "decrement" "3";
    }
    XF86AudioMute allow-when-locked=true {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle";
        // spawn "dms" "ipc" "call" "audio" "mute";
        // spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle";
    }

    // 麦克风静音（DMS 暂无对应 IPC，所以保留 wpctl）
    XF86AudioMicMute allow-when-locked=true {
        spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle";
    }

    // 亮度（由 DMS 接管）
    XF86MonBrightnessUp allow-when-locked=true {
       spawn "dms" "ipc" "call" "brightness" "increment" "5" "";
    }
    XF86MonBrightnessDown allow-when-locked=true {
       spawn "dms" "ipc" "call" "brightness" "decrement" "5" "";
    }

    // ---- Media keys (use playerctl, most reliable) ----
    // XF86AudioPlay allow-when-locked=true hotkey-overlay-title="播放/暂停" {
    //     spawn "playerctl" "play-pause";
    // }
    // XF86AudioNext allow-when-locked=true hotkey-overlay-title="下一曲" {
    //     spawn "playerctl" "next";
    // }
    // XF86AudioPrev allow-when-locked=true hotkey-overlay-title="上一曲" {
    //     spawn "playerctl" "previous";
    // }

    // ---------- 无障碍/杂项 ----------
    // Orca 屏幕阅读器开关
    // Super+Alt+S allow-when-locked=true hotkey-overlay-title=null {
    //     spawn-sh "pkill orca || exec orca";
    // }


    // ---------- 概览/窗口基础操作 ----------
    // Overview 总览
    Mod+O repeat=false { toggle-overview; }
    // 关闭窗口
    Mod+Q repeat=false { close-window; }

    // ---------- 焦点移动（窗口/列） ----------
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    // vim 风格
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    // ---------- 移动窗口/列 ----------
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    // vim 风格
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+J     { move-window-down; }

    // ---------- 列定位 ----------
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // ---------- 显示器切换/搬移 ----------
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Down  { focus-monitor-down; }
    // vim 风格
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+L     { focus-monitor-right; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+J     { focus-monitor-down; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    // vim 风格
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }

    // ---------- 工作区切换/搬移 ----------
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }

    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // 鼠标滚轮切工作区/移动列
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // 滚轮左右切列/移动列
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // Shift+滚轮实现水平滚动（这里映射为列切换）
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // 数字工作区：跳转 / 搬列
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // ---------- 列结构操作 ----------
    Mod+BracketLeft  { consume-or-expel-window-left; }   // 左吸入/弹出
    Mod+BracketRight { consume-or-expel-window-right; }  // 右吸入/弹出

    // 原 Mod+Comma 被 DMS 设置占用，所以把“吸入一个窗口”挪到 Mod+Shift+Comma
    Mod+Shift+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }            // 弹出底部窗口

    // ---------- 尺寸/布局 ----------
    Mod+R { switch-preset-column-width; }        // 列宽预设循环
    Mod+Shift+R { switch-preset-window-height; } // 窗口高预设循环
    Mod+Ctrl+R { reset-window-height; }

    Mod+F { maximize-column; }           // 最大化列
    Mod+Shift+F { fullscreen-window; }   // 全屏
    Mod+Return { fullscreen-window; }
    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // 浮动切换：原 Mod+V 被剪贴板占用，挪到 Mod+Alt+V
    Mod+Alt+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Mod+W { toggle-column-tabbed-display; }

    // ---------- 截图 ----------
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // ---------- 输入/会话控制 ----------
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    Mod+Shift+P { power-off-monitors; }

    Mod+E { spawn "thunar"; }
    Mod+B { spawn "zen-browser"; }
}

// debug {
//     force-pipewire-invalid-modifier
// }
